<Project>
  <!-- ONE place to change the .NET version. SDK 10: net10.0 and 10.*  |  SDK 9: net9.0 and 9.* -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EfVersion>10.*</EfVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>
